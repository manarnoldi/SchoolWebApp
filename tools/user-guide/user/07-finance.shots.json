 {
  "name": "fin-payment-new",
  "path": "/finance/payments",
  "waitFor": "table tbody tr",
  "steps": [
   {
    "click": "button:has-text('New Payment')"
   },
   {
    "waitFor": ".modal-content",
    "wait": 600
   },
   {
    "eval": "(()=>{const s=document.querySelectorAll('.modal-content select')[0]; s.selectedIndex=2; s.dispatchEvent(new Event('change'));})()",
    "wait": 1200
   },
   {
    "select": [
     ".modal-content select >> nth=2",
     "Day Care - E"
    ],
    "wait": 1500
   },
   {
    "click": ".modal-content ng-select",
    "wait": 500
   },
   {
    "fill": [
     ".modal-content ng-select input",
     "FELIX"
    ]
   },
   {
    "wait": 800
   },
   {
    "press": "Enter",
    "wait": 1500
   },
   {
    "eval": "(async()=>{for(let k=0;k<40;k++){const s=document.querySelectorAll('.modal-content select')[3]; if(s&&s.options.length>1){s.selectedIndex=1; s.dispatchEvent(new Event('change')); return;} await new Promise(r=>setTimeout(r,300));}})()",
    "wait": 1500
   },
   {
    "fill": [
     ".modal-content input[type=number]",
     "2000"
    ]
   },
   {
    "fill": [
     ".modal-content input >> nth=-3",
     "QK7T2M9XPL"
    ]
   },
   {
    "wait": 800
   }
  ],
  "element": ".modal-content",
  "height": 900
