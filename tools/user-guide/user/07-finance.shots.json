   {
    "eval": "(()=>{const v=[\"6000\",\"4500\",\"3200\"]; const a=[...document.querySelectorAll('.modal-content table input[type=number]')]; a.forEach((x,i)=>{if(v[i]!=null){x.value=v[i]; x.dispatchEvent(new Event('input'));}});})()",
