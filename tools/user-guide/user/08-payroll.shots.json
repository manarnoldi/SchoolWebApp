 {
  "name": "pay-payslip-view",
  "path": "/payroll/periods",
  "waitFor": "table tbody tr td strong",
  "steps": [
   {
    "click": "button[title='Payslips']"
   },
   {
    "waitFor": "app-payroll-payslips table tbody tr td strong",
    "wait": 800
   },
   {
    "eval": "/* the slip preview is an iframe, which never lets the page go network-idle: draw it in a plain box instead */ (()=>{const o=document.createElement.bind(document);document.createElement=function(t,...r){if(String(t).toLowerCase()==='iframe'){const d=o('div');const sh=d.attachShadow({mode:'open'});Object.defineProperty(d,'srcdoc',{set(v){sh.innerHTML=String(v&&v.changingThisBreaksApplicationSecurity||v);d.style.height='auto';d.style.padding='8px';},get(){return ''}});return d;}return o(t,...r);};})()"
   },
   {
    "click": "button[title='View this payslip']",
    "wait": 1500
   },
   {
    "eval": "document.querySelectorAll('.modal-dialog-scrollable').forEach(e=>e.classList.remove('modal-dialog-scrollable'))",
    "wait": 300
   }
  ],
  "height": 1300,
  "element": ".modal-content"
 },
