    "click": ".list-group-item >> text=Competencies",
    "wait": 1200
   }
  ],
  "element": "section.content .col-md-3"
 },
 {
  "name": "aaca-exam-type-form",
  "path": "/settings/dropdowns?category=Academics",
  "waitFor": "text=Exam Types",
  "steps": [
   {
    "click": ".list-group-item >> text=Exam Types",
    "wait": 1000
   },
   {
    "click": "text=Add Exam Types",
    "wait": 800
   },
   {
    "waitFor": "#dropdownItemModal.show .modal-content"
   }
  ],
  "element": "#dropdownItemModal .modal-content"
 },
 {
