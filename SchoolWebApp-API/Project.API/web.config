<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <location path="." inheritInChildApplications="false">
    <system.webServer>
      <modules runAllManagedModulesForAllRequests="false">
        <remove name="WebDAVModule" />
      </modules>
      <handlers>
        <remove name="WebDAV" />
        <remove name="OPTIONSVerbHandler" />
        <add name="aspNetCore" path="*" verb="*" modules="AspNetCoreModuleV2" resourceType="Unspecified" />
      </handlers>
      <security>
        <requestFiltering>
          <!-- Batch endpoints (exam results / value scores) can post large JSON
               payloads. Raise IIS's default ~28.6 MB body cap to 100 MB so big
               batches aren't rejected with a 413 before reaching Kestrel. The
               slow-upload timeout itself is handled in Program.cs via
               MinRequestBodyDataRate. -->
          <requestLimits maxAllowedContentLength="104857600" />
        </requestFiltering>
      </security>
      <aspNetCore processPath="dotnet" arguments=".\SchoolWebApp.API.dll" stdoutLogEnabled="true" stdoutLogFile=".\logs\stdout" hostingModel="inprocess" />
    </system.webServer>
  </location>
</configuration>
